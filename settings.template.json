{
  "permissions": {
    "allow": [
      "Edit(**/.claude/ACTION-ITEMS.md)",
      "Edit(**/.claude/logs/*.md)",
      "Edit(**/.claude/completed_archive.md)",
      "Write(**/.claude/completed_archive.md)",
      "Write(**/.claude/logs/*.md)"
    ]
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/protect-raw-data.sh\""
          }
        ]
      }
    ]
  }
}
